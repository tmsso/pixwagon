{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixwagon",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }],
  },

  "migrations": [
    {
      "tag": "v1",
      // MUST be `new_sqlite_classes`, not `new_classes`.
      //
      // Durable Objects are available on the Workers *Free* plan only with the
      // SQLite storage backend; the key-value backend still requires a paid
      // plan. Declaring this class with `new_classes` would make the very first
      // deploy fail on a free account — and because the migration list is
      // append-only, fixing it afterwards is more annoying than getting it right
      // now. See ROADMAP.md Phase 3.5.
      "new_sqlite_classes": ["Room"],
    },
  ],

  "observability": {
    "enabled": true,
  },
}
